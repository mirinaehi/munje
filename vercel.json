{
  "installCommand": "npm install",
  "buildCommand": "echo \"No build step required for API deployment\"",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/$1"
    }
  ]
}
