{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "서버 디버그 실행",
      "program": "${workspaceFolder}/server/index.js",
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "runtimeArgs": ["--watch"],
      "env": {
        "PORT": "4000"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
